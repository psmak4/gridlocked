# Variable names only. Real values live in the host's settings, never in git.

# Postgres connection string (the pooled one on a deployed host).
DATABASE_URL=

# Better Auth. The secret is at least 32 random characters
# (`openssl rand -base64 32`); the URL is the site's one public address.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Optional. Comma-separated; when set, only these addresses may sign up.
SIGN_UP_ALLOWED_EMAILS=

# Build-time only: "1" builds with an in-memory PGlite for local runs and the
# e2e tests. Never set it for a deployed build.
VITE_LOCAL_DB=
