{
  "name": "gridlocked",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:drift": "node scripts/db-drift.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:staging": "pnpm db:migrate",
    "import:2026": "tsx scripts/import-2026.ts",
    "staff": "tsx scripts/staff.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "@base-ui/react": "1.9.0",
    "@better-auth/core": "1.7.18",
    "@better-auth/drizzle-adapter": "1.7.18",
    "@fontsource/anton": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@neondatabase/serverless": "1.2.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "better-auth": "1.7.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "uuidv7": "^1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@neon/config": "1.13.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "nitro": "3.0.260903-beta",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
